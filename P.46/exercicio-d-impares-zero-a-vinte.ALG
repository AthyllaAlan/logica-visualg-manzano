Algoritmo "Exercicio-d-ImparesZeroAVinte"
// Disciplina   : [Lógica de Programação]
// Professor    : Jaison Costa Dos Santos
// Descrição    : Apresenta os números ímpares entre 0 e 20 utilizando a instrução se dentro do laço enquanto.
// Autor(a)     : Athylla Alan Dos Santos Oliveira
// Data atual   : 28/09/2026
Var
// Seção de Declarações das variáveis 
numero : inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
numero <- 0

enquanto (numero <= 20) faca
se (numero mod 2 = 1) entao
escreval(numero)

fimse

numero <- numero + 1

fimenquanto

Fimalgoritmo