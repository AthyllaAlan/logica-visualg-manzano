Algoritmo "exercicio-d-soma-pares-1-a-500"
// Disciplina   : [Lógica de Programação]
// Professor    : Jaison Costa Dos Santos
// Descrição    : Apresenta o somatório dos números pares de 1 até 500 usando a estrutura para.
// Autor(a)     : Athylla Alan Dos Santos Oliveira
// Data atual   : 30/09/2026
Var
// Seção de Declarações das variáveis 
contador, soma : inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
soma <- 0

para contador de 2 ate 500 passo 2 faca
soma <- soma + contador
fimpara

escreval("O somatório dos valores pares de 1 até 500 é: ", soma)

Fimalgoritmo