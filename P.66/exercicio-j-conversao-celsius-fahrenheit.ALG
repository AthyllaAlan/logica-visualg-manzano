Algoritmo "exercicio-j-conversao-celsius-fahrenheit"
// Disciplina   : [Lógica de Programação]
// Professor    : Jaison Costa Dos Santos
// Descrição    : Apresenta a conversão de graus Celsius para Fahrenheit de 10 em 10 ate 100 graus usando para.
// Autor(a)     : Athylla Alan Dos Santos Oliveira
// Data atual   : 30/09/2026
Var
// Seção de Declarações das variáveis 
celsius : inteiro
fahrenheit : real

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
para celsius de 10 ate 100 passo 10 faca
fahrenheit <- (9 * celsius + 160) / 5
escreval(celsius, " °C = ", fahrenheit, " °F")
fimpara


Fimalgoritmo