Algoritmo "exercicio-a-quadrados-15-a-200"
// Disciplina   : [Lógica de Programação]
// Professor    : Jaison Costa Dos Santos
// Descrição    : Apresenta os quadrados dos números inteiros de 15 a 200 usando a estrutura para.
// Autor(a)     : Athylla Alan Dos Santos Oliveira
// Data atual   : 30/09/2026
Var
// Seção de Declarações das variáveis 
contador, quadrado : inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
para contador de 15 ate 200 faca
quadrado <- contador * contador
escreval("O quadrado de ", contador, " é: ", quadrado)
fimpara

Fimalgoritmo