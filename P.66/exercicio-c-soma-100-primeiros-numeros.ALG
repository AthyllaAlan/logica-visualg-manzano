Algoritmo "exercicio-c-soma-100-primeiros-numeros"
// Disciplina   : [Lógica de Programação]
// Professor    : Jaison Costa Dos Santos
// Descrição    : Apresenta a soma dos cem primeiros números inteiros (1 a 100) usando a estrutura para.
// Autor(a)     : Athylla Alan Dos Santos Oliveira
// Data atual   : 30/09/2026
Var
// Seção de Declarações das variáveis 
contador, soma : inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
soma <- 0

para contador de 1 ate 100 faca
soma <- soma + contador
fimpara

escreval("O total da soma dos cem primeiros números inteiros é: ", soma)

Fimalgoritmo