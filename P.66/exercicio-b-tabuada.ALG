Algoritmo "exercicio-b-tabuada"
// Disciplina   : [Lógica de Programação]
// Professor    : Jaison Costa Dos Santos
// Descrição    : Apresenta a tabuada de 1 a 10 de um número qualquer usando a estrutura para.
// Autor(a)     : Athylla Alan Dos Santos Oliveira
// Data atual   : 30/09/2026
Var
// Seção de Declarações das variáveis 
numero, contador, resultado : inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
escreval("Digite um número para ver a sua tabuada:")
leia(numero)
escreval("")

para contador de 1 ate 10 faca
resultado <- numero * contador
escreval(numero, " x ", contador, " = ", resultado)
fimpara

Fimalgoritmo