algoritmo "exercicio-g-potencias-de-3"
// Disciplina   : [Lógica de Programação]
// Professor    : Jaison Costa Dos Santos
// Descrição    : Apresenta as potências de base 3 para expoentes de 0 a 15 sem usar o operador ^.
// Autor(a)     : Athylla Alan Dos Santos Oliveira
// Data atual   : 30/09/2026
Var
// Seção de Declarações das variáveis 
expoente, potencia : inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
potencia <- 1

para expoente de 0 ate 15 faca
escreval("3 elevado a ", expoente, " = ", potencia)
potencia <- potencia * 3
fimpara

Fimalgoritmo