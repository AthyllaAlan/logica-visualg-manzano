Algoritmo "VolumeCaixa"
// Disciplina   : [Lógica de Programação]
// Professor   : Jaison Costa Dos Santos
// Descrição   : O programa faz uma conta de multiplicação para encontrar o volume da caixa
// Autor(a)    : Athylla Alan Dos Santos Oliveira
// Data atual  : 26/09/2026
Var
// Seção de Declarações das variáveis 
comprimento, largura, altura, volume : real

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
Escreval("Digite o comprimento:")
leia(comprimento)
Escreval("Digite a largura:")
leia(largura)
Escreval("Digite a altura:")
leia(altura)

volume <- comprimento * largura * altura

Escreval("O volume da caixa é:" , volume)



Fimalgoritmo