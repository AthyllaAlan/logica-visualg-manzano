Algoritmo "ConversorTemperatura"
// Disciplina   : [Lógica de Programação]
// Professor   : Jaison Costas Dos Santos
// Descrição   : Converte uma temperatura informada em graus Celsius para Fahrenheit.
// Autor(a)    : Athylla Alan Dos Santos Oliveira
// Data atual  : 21/09/2026
Var
// Seção de Declarações das variáveis 
Celsius : real

Fahrenheit : real

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
Escreval("Digite a temperatura em Celsius:")
leia(Celsius)

Fahrenheit <- ( 9 * Celsius + 160) / 5

Escreval(" A temperatura é:" , Fahrenheit)

Fimalgoritmo