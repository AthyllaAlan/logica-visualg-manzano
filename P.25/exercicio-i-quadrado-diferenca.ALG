Algoritmo "QuadradoDaDiferenca"
// Disciplina   : [Lógica de Programação]
// Professor   : Jaison Costa Dos Santos
// Descrição   : Calcula e exibe o resultado do quadrado da diferença do primeiro valor pelo segundo.
// Autor(a)    : Athylla Alan Dos Santos Oliveira
// Data atual  : 27/09/2026
Var
// Seção de Declarações das variáveis 
A,B : inteiro
resultadoQuadrado : inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
Escreval("Digite o valor da letra A:")
leia(A)
Escreval("Digite o valor da letra B:")
leia(B)

resultadoQuadrado <- (A - B) * (A - B)

Escreval("O resultado do quadrado é: " , resultadoQuadrado)


Fimalgoritmo